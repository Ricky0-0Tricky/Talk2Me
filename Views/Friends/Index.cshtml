@model IEnumerable<Talk2Me.Models.Friend>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IsFavorite)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsBlocked)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BlockedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FriendUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IsFavorite)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsBlocked)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BlockedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.PasswordHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FriendUser.PasswordHash)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FriendId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FriendId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FriendId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
