@model Talk2Me.Models.Reaction

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Reaction</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReactionId" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsUpvote" /> @Html.DisplayNameFor(model => model.IsUpvote)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ForumId" class="control-label"></label>
                <select asp-for="ForumId" class="form-control" asp-items="ViewBag.ForumId"></select>
                <span asp-validation-for="ForumId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CommentId" class="control-label"></label>
                <select asp-for="CommentId" class="form-control" asp-items="ViewBag.CommentId"></select>
                <span asp-validation-for="CommentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
