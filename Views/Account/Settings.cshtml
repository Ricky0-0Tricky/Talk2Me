@model Talk2Me.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Settings";
}

<div class="settings-page">
    <div class="settings-card">
        <div class="settings-header">
            <h1>Settings</h1>
            <p>
                Manage your Talk2Me account.
            </p>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>
        <form asp-action="Settings"
              method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="settings-profile">
                <img src="@Url.Action("ProfileImage", "Users", new {id = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value})"
                     alt="Profile picture"
                     class="settings-profile-image" />
                <div class="profile-upload">
                    <label asp-for="ProfilePic"
                           class="form-label">
                        Profile Picture
                    </label>
                    <input asp-for="ProfilePic"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="ProfilePic"
                          class="text-danger">
                    </span>
                    <small class="text-muted">
                        JPG, PNG or WebP. Maximum 1 MB.
                    </small>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">
                </label>
                <input asp-for="Email"
                       class="form-control" />
                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>
            <hr />
            <h3>Password</h3>
            <p class="text-muted">
                Leave these fields empty if you do not want to
                change your password.
            </p>
            <div class="mb-3">
                <label asp-for="NewPassword"
                       class="form-label">
                </label>
                <input asp-for="NewPassword"
                       class="form-control" />
                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword"
                       class="form-label">
                </label>
                <input asp-for="ConfirmNewPassword"
                       class="form-control" />
                <span asp-validation-for="ConfirmNewPassword"
                      class="text-danger">
                </span>
            </div>
            <div class="settings-actions">
                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}