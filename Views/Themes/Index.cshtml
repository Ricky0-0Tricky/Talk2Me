@model IEnumerable<Talk2Me.Models.Theme>

@{
    ViewData["Title"] = "Theme List";
}

<h1>Theme List</h1>

<p>
    <a asp-action="Create">Create a Theme</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ThemeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreationDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ThemeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreationDate)
            </td>
            <td>
                    <form asp-controller="Themes"
                          asp-action="Delete"
                          asp-route-id="@item.ThemeId"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn btn-link p-0">
                            Delete
                        </button>
                    </form>
            </td>
        </tr>
}
    </tbody>
</table>
